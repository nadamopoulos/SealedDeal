{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/deals/index.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/deals/[dealId]/index.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/deals/[dealId]/analyze.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/deals/[dealId]/upload.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/deals/[dealId]/qa.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
